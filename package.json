{
  "name": "behavioral-data-website",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "npm run validate && next build && node scripts/export-aliases.mjs && python3 scripts/check-export.py",
    "preview": "python3 -m http.server 3000 --bind 127.0.0.1 --directory out",
    "test": "node --test tests/*.test.mjs",
    "validate": "node scripts/validate-content.mjs && python3 scripts/validate-maintenance.py",
    "test:python": "python3 -m unittest discover -s tests -p 'test_*.py'",
    "check": "npm test && npm run test:python && npm run build",
    "discover": "python3 scripts/discovery.py",
    "test:skeleton": "python3 scripts/test-skeleton.py"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0"
  }
}
